{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Represents a student or teacher profile on the platform.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "teacher", "admin"] },
        "walletId": { "type": "string", "description": "Short unique identifier for transfers" },
        "monnifyAccountNumber": { "type": "string" },
        "monnifyBankName": { "type": "string" },
        "status": { "type": "string", "description": "WhatsApp-like status message" },
        "stream": { "type": "string", "enum": ["Science", "Art", "Commercial"], "description": "Student academic stream" },
        "followersCount": { "type": "number", "default": 0 },
        "followingCount": { "type": "number", "default": 0 },
        "isVerifiedTeacher": { "type": "boolean" },
        "walletBalance": { "type": "number", "description": "Current balance in Naira (NGN)" },
        "teacherProfile": {
          "type": "object",
          "properties": {
            "qualifications": { "type": "string" },
            "subjects": { "type": "array", "items": { "type": "string" } },
            "experience": { "type": "number" },
            "approvalStatus": { "type": "string", "enum": ["pending", "approved", "rejected"] }
          }
        },
        "stats": {
          "type": "object",
          "properties": {
            "totalQuizzes": { "type": "number" },
            "averageScore": { "type": "number" },
            "questionsContributed": { "type": "number" },
            "approvalRate": { "type": "number" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "walletBalance"]
    },
    "Question": {
      "title": "Exam Question",
      "description": "A student-facing MCQ question contributed by teachers or official sources.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "image": { "type": "string", "description": "Optional URL for question illustration" },
        "options": { "type": "array", "items": { "type": "string" } },
        "correctOption": { "type": "number", "description": "Index of the correct option (0-4)" },
        "explanation": { "type": "string" },
        "subject": { "type": "string" },
        "topic": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
        "examType": { "type": "string", "enum": ["JAMB", "WAEC", "NECO", "NABTEB", "Post-UTME", "General"] },
        "creatorId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "rejectionReason": { "type": "string" },
        "usageCount": { "type": "number" },
        "ratingSum": { "type": "number" },
        "ratingCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "options", "correctOption", "subject", "creatorId", "status"]
    },
    "Attempt": {
      "title": "Quiz Attempt",
      "description": "A record of a student completing a practice session.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "score": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "duration": { "type": "number", "description": "Seconds taken" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "score", "timestamp"]
    },
    "Transaction": {
      "title": "Wallet Transaction",
      "description": "Log of earnings, rewards, or payouts.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["reward", "contribution_payout", "usage_royalty", "withdrawal"] },
        "status": { "type": "string", "enum": ["completed", "pending", "failed"] },
        "description": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "amount", "type", "timestamp"]
    },
    "Post": {
      "title": "Timeline Post",
      "description": "A post shared by a student to their followers/timeline.",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorPhoto": { "type": "string" },
        "content": { "type": "string" },
        "image": { "type": "string" },
        "likesCount": { "type": "number", "default": 0 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "content", "createdAt"]
    },
    "ChatMessage": {
      "title": "Direct Message",
      "description": "Private message between two students.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "receiverId": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "receiverId", "text", "createdAt"]
    },
    "ForumMessage": {
      "title": "Forum Message",
      "description": "Message posted in a stream-specific forum.",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "stream": { "type": "string", "enum": ["Science", "Art", "Commercial", "General"] },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "stream", "text", "createdAt"]
    },
    "Follow": {
      "title": "Follow Relationship",
      "description": "Tracks which student follows another.",
      "type": "object",
      "properties": {
        "followerId": { "type": "string" },
        "followingId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["followerId", "followingId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and wallet data."
    },
    "/questions/{questionId}": {
      "schema": "Question",
      "description": "Global repository of exam questions."
    },
    "/attempts/{attemptId}": {
      "schema": "Attempt",
      "description": "Practice history."
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Financial ledger for rewards and earnings."
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Timeline posts."
    },
    "/chats/{chatId}": {
      "schema": "ChatMessage",
      "description": "Direct messages."
    },
    "/forums/{messageId}": {
      "schema": "ForumMessage",
      "description": "Public forum messages grouped by stream."
    },
    "/follows/{followId}": {
      "schema": "Follow",
      "description": "Follower relationships."
    }
  }
}
