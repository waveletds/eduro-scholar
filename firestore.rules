rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.uid == request.auth.uid 
        && data.email == request.auth.token.email
        && data.role in ['student', 'teacher', 'admin']
        && data.walletBalance is number
        && data.walletBalance >= 0;
    }

    function isValidQuestion(data) {
      return data.text is string && data.text.size() <= 5000
        && data.options is list && data.options.size() >= 2 && data.options.size() <= 5
        && data.correctOption is int && data.correctOption >= 0 && data.correctOption < data.options.size()
        && data.subject is string && data.subject.size() <= 100
        && data.creatorId == request.auth.uid
        && data.status in ['pending', 'approved', 'rejected'];
    }

    // --- Collection Rules ---

    // Users
    match /users/{userId} {
      allow get: if isSignedIn(); // Allow profile view for collaboration
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      
      allow create: if isOwner(userId) && isEmailVerified() && isValidUser(incoming())
        && incoming().walletBalance == 0; // Fresh account must have 0 balance
      
      allow update: if isSignedIn() && (
        (isOwner(userId) && isValidUser(incoming()) && (
          incoming().walletBalance == existing().walletBalance
          || (incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt', 'displayName', 'photoURL', 'teacherProfile']))
        ))
        ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['walletBalance', 'stats', 'updatedAt']))
        ||
        isAdmin()
      );
    }

    // Questions
    match /questions/{questionId} {
      // Students can only see approved questions
      allow list: if isSignedIn() && resource.data.status == 'approved';
      allow get: if isSignedIn() && (resource.data.status == 'approved' || resource.data.creatorId == request.auth.uid);
      
      allow create: if isSignedIn() && isEmailVerified() && isValidQuestion(incoming())
        && incoming().status == 'pending'
        && incoming().usageCount == 0;
      
      allow update: if isSignedIn() && (
        // Teacher can only update their own pending/rejected questions
        (isOwner(existing().creatorId) && existing().status != 'approved' && isValidQuestion(incoming()) 
         && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'options', 'correctOption', 'subject', 'topic', 'explanation', 'status', 'updatedAt']))
        || 
        // Usage increment (strictly usage count)
        (incoming().diff(existing()).affectedKeys().hasOnly(['usageCount', 'ratingSum', 'ratingCount']))
      );
      
      allow delete: if isSignedIn() && isOwner(existing().creatorId) && existing().status == 'pending';
    }

    // Attempts
    match /attempts/{attemptId} {
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Transactions
    match /transactions/{transactionId} {
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (
        incoming().userId == request.auth.uid
        || incoming().type == 'usage_royalty'
      );
    }

    // Test connection helper
    match /test/connection {
      allow read: if true;
    }
  }
}
